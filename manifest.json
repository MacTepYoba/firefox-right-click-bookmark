{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ru",
  "version": "1.3.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "right-click-bookmark@mactepyoba",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "menus",
    "bookmarks",
    "tabs",
    "storage"
  ],
  "author": "Evgeny Khramtsov",
  "homepage_url": "https://github.com/MacTepYoba"
}
